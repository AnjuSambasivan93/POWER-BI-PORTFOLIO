                <property
                  dataType="System.String"
                  description="The SQL command to be executed."
                  name="SqlCommand"
                  UITypeEditor="Microsoft.DataTransformationServices.Controls.ModalMultilineStringEditor">SELECT DISTINCT
    postcode AS Postcode,
    suburb AS Suburb,
    city AS City,
    state AS State,
    state_code AS StateCode,
    TRY_CAST(lat AS DECIMAL(10,6)) AS Latitude,
    TRY_CAST(lon AS DECIMAL(10,6)) AS Longitude,
    Distric AS District
FROM dbo.load_Location
WHERE state = 'New South Wales'
   OR state_code = 'NSW';</property>
